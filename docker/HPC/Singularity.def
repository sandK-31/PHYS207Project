Bootstrap: docker
From: sandk33/ansg-base-env:latest

%setup
    # Optional: copy anything you need into /ansg here

%post
    mkdir -p /ansg
    echo "source /opt/root/bin/thisroot.sh" >> /ansg/env.sh
    echo "source /opt/geant4/bin/geant4.sh" >> /ansg/env.sh
    echo "source /opt/ratpac-two/ratpac.sh" >> /ansg/env.sh

%environment
    export HOME=$HOME
    export LD_LIBRARY_PATH=/opt/geant4/lib:$LD_LIBRARY_PATH
    export RATSHARE=/opt/ratpac-two
    export PATH=/opt/root/bin:/opt/geant4/bin:/opt/ratpac-two:$PATH
    export DISPLAY=:1.0
    export XAUTHORITY=/root/.Xauthority

%runscript
    exec /bin/bash -c "source /ansg/env.sh && exec bash"


%startscript
    # Optional X11 setup
